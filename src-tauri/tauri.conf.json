{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Novly",
  "version": "1.2.0",
  "identifier": "com.lightnooklabs.novly",
  "build": {
    "beforeDevCommand": "pnpm run web",
    "devUrl": "http://localhost:8081",
    "beforeBuildCommand": "npx expo export --platform web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Novly",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": true,
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}